{% extends 'templates/_document.twig' %}

{% block content %}
  {% set categoryTerm = post.terms('category')|first %}
  {% set categoryColor = categoryTerm ? categoryTerm.meta('categoryColor') : null %}
  {% if categoryColor %}
    <div class="project-orbs pointer-events-none fixed inset-0 z-[2999] overflow-hidden" aria-hidden="true" style="--cat-color: {{ categoryColor }};">
      <span class="project-orb project-orb--1"></span>
      <span class="project-orb project-orb--2"></span>
      <span class="project-orb project-orb--3"></span>
    </div>
    <style>
      .project-orb {
        position: absolute;
        display: block;
        border-radius: 9999px;
        background-color: var(--cat-color);
        opacity: 0.45;
        will-change: transform;
        mix-blend-mode: multiply;
      }
      .project-orb--1 { width: 40px; height: 40px; top: 30%; left: 6%; animation: orbFloat1 100s ease-in-out infinite alternate; }
      .project-orb--2 { width: 40px; height: 40px; top: 60%; left: 78%; animation: orbFloat2 100s ease-in-out infinite alternate; }
      .project-orb--3 { width: 40px; height: 40px; top: 70%; left: 28%; animation: orbFloat3 100s ease-in-out infinite alternate; }
      @keyframes orbFloat1 {
        0%   { transform: translate(0, 0); }
        50%  { transform: translate(35vw, 28vh); }
        100% { transform: translate(60vw, 5vh); }
      }
      @keyframes orbFloat2 {
        0%   { transform: translate(0, 0); }
        50%  { transform: translate(-45vw, -22vh); }
        100% { transform: translate(-25vw, 35vh); }
      }
      @keyframes orbFloat3 {
        0%   { transform: translate(0, 0); }
        50%  { transform: translate(28vw, -38vh); }
        100% { transform: translate(-18vw, -22vh); }
      }
      @media (prefers-reduced-motion: reduce) {
        .project-orb { animation: none; }
      }
    </style>
  {% endif %}
  <article class="post mt-pageTop boxed relative z-10">
    <div 
      class="w-full mx-auto flex flex-col justify-between items-center">
      <div class="wrapper max-w-screen-max mx-auto">
        <a href="javascript:history.back()" class="button button--outline no-underline !py-min mb-xs">
          <span class="font-small inline-flex items-center gap-xs">
            {{ singleProject.backLabel|default('Go back') }}
            <svg class="shrink-1" width="29" height="12" viewBox="0 0 29 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0.219669 4.99262C-0.0732231 5.28551 -0.0732231 5.76039 0.219669 6.05328L4.99264 10.8263C5.28553 11.1191 5.76041 11.1191 6.0533 10.8263C6.34619 10.5334 6.34619 10.0585 6.0533 9.76559L1.81066 5.52295L6.0533 1.28031C6.34619 0.987415 6.34619 0.512542 6.0533 0.219648C5.76041 -0.073245 5.28553 -0.073245 4.99264 0.219648L0.219669 4.99262ZM28.75 5.52295V4.77295L0.75 4.77295V5.52295V6.27295L28.75 6.27295V5.52295Z" fill="currentColor"/>
            </svg>
          </span>
        </a>
        <div class="flex flex-col gap-md h-full relative">
          {# Top #}
          <div class="w-full relative">
            {{ renderComponent('PostGallery', { post: post }) }}
          </div>
          {# Bottom #}
          <div class="w-full lg:w-full h-full flex flex-col justify-between">
            <div class="flex flex-col md:flex-row justify-between items-end gap-sm pb-md border-b">
              <h1 class="w-full flex flex-col gap-min items-start justify-start">
                <span class="font-h1 !mb-0">{{ post.postArtist }}</span>
                <span class="font-h1">{{ post.title }}</span>
              </h1>
              <div class="w-full flex flex-col gap-min md:items-end md:justify-end">
                {# <div class="">
                  {% set postCategories = post.terms('category') %}
                  {% for term in postCategories %}
                    <span class="font-bodySmall !mb-0">{{ term }}{% if not loop.last %},{% endif %}</span>
                  {% endfor %}
                </div> #}
                <div class="">
                  {% if post.dateStart %}
                    <span class="font-h2 !mb-0">{{ post.dateStart('d.m.Y') }} - </span>
                  {% endif %}
                  {% if post.dateEnd %}
                    <span class="font-h2 !mb-0">{{ post.dateEnd('d.m.Y') }}</span>
                  {% endif %}
                </div>
                {% if post.postLocation %}
                  <div class="font-h2Regular !mb-0">{{ post.postLocation }}</div>
                {% endif %}
              </div>
            </div>
            <div class="flex flex-col pt-md">
              {% if post.postDescription %}
                <div class="flex flex-col w-full lg:w-[calc(66%_-_12.5px)] mr-auto">
                  <p class="font-bodySans">{{ post.postDescription }}</p>
                </div>
              {% endif %}
              <section class="post-main">
                {% for component in post.meta('postComponents') %}
                  {{ renderComponent(component) }}
                {% endfor %}
              </section>
            </div>
          </div>
        </div>
      </div>
    </div>
    {# <section class="post-related">
      {{ renderComponent('RelatedPosts', {'preContentTitle': '<h2>' ~ __('Related News') ~ '</h2>', 'taxonomies': post.categories(), 'options': {'maxPosts': 3}}) }}
    </section>
    <footer>
      {{ renderComponent('BlockPostNav', { post: post }) }}
    </footer> #}
  </article>
{% endblock %}
