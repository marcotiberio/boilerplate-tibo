{% extends 'templates/_document.twig' %}

{% block content %}
  <article class="post pt-xl pb-xl">

    {# ---- Header: back-nav · date · title · intro ---- #}
    <header class="w-full max-w-screen-md mx-auto px-xs md:px-lg">
      {% set newsUrl = function('get_permalink', function('get_option', 'page_for_posts')) %}
      <a
        href="{{ newsUrl ?: function('home_url', '/') }}"
        class="no-underline inline-flex items-center gap-min text-muted-black opacity-50 transition-opacity hover:opacity-100">
        <span class="font-body !mb-0 before:content-['‹'] before:mr-min">{{ __('Alle News', 'flynt') }}</span>
      </a>

      <div class="max-w-[676px] mt-sm flex flex-col gap-xs">
        {% if post.date %}
          <p class="font-body !mb-0 text-muted-black">{{ post.date('j. F Y') }}</p>
        {% endif %}
        <h1 class="font-h1 text-dark-brown">{{ post.title }}</h1>
        {% if post.postIntro %}
          <p class="font-body !mb-0 text-dark-brown">{{ post.postIntro }}</p>
        {% endif %}
      </div>
    </header>

    {# ---- Featured image with optional copyright caption ---- #}
    {% if post.thumbnail %}
      <figure class="relative w-full max-w-screen-lg mx-auto mt-md px-xs md:px-lg">
        <div class="relative w-full overflow-hidden rounded-card">
          <img
            class="block w-full h-full object-cover aspect-[16/9]"
            src="{{ post.thumbnail.src }}"
            srcset="{{ function('wp_get_attachment_image_srcset', post.thumbnail.id) }}"
            sizes="(min-width: 910px) 910px, 100vw"
            alt="{{ post.thumbnail.alt|e | default(post.title) }}"
            loading="eager" />
        </div>
        {% if post.thumbnail.caption %}
          <figcaption class="absolute bottom-md right-md z-10 rotate-2">
            <span class="flex items-center gap-1.5 rounded-card bg-warmer-beige px-3.5 py-2.5 font-small text-dark-brown">
              <svg class="w-3.5 h-3.5 shrink-0 -rotate-2" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                <circle cx="7" cy="7" r="6" />
                <path d="M7 6.2v3.4M7 4.2v.1" stroke-linecap="round" />
              </svg>
              {{ post.thumbnail.caption }}
            </span>
          </figcaption>
        {% endif %}
      </figure>
    {% endif %}

    {# ---- Author ---- #}
    {% if post.postAuthor %}
      <div class="w-full max-w-screen-md mx-auto mt-md px-xs md:px-lg">
        <p class="font-body !mb-0 text-muted-black">{{ __('Von', 'flynt') }} {{ post.postAuthor }}</p>
      </div>
    {% endif %}

    {# ---- Body / modules (self-contained components) ---- #}
    <section class="post-main max-w-screen-md mx-auto px-xs md:px-lg">
      {% for component in post.meta('postComponents') %}
        {{ renderComponent(component) }}
      {% endfor %}
    </section>

  </article>
{% endblock %}
