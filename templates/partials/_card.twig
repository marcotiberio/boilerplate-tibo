{# Teaser card for projects and publications: image, meta line, title, excerpt, button #}
<article class="flex flex-col w-full bg-white text-ink h-full">
  {% if image %}
    <figure class="aspect-16/10 overflow-hidden">
      <img
        class="lazyload w-full h-full object-cover"
        src="{{ image.src|resize(32) }}"
        data-srcset="{{ function('wp_get_attachment_image_srcset', image.id) }}"
        data-sizes="auto"
        alt="{{ image.alt|e }}">
    </figure>
  {% endif %}
  <div class="flex flex-col grow gap-xs p-sm">
    {% if meta %}
      <p class="meta !mb-0">{{ meta|e }}</p>
    {% endif %}
    <h3 class="!mb-0">{{ title|e }}</h3>
    {% if excerpt %}
      <p class="!mb-0">{{ excerpt|e }}</p>
    {% endif %}
    {% if link %}
      <a
        class="button button--forest mt-auto"
        href="{{ link|e('esc_url') }}"
        {% if external %}target="_blank" rel="noopener noreferrer"{% endif %}
        aria-label="{{ linkLabel|e }}: {{ title|e }}">
        {{ linkLabel|e }}
      </a>
    {% endif %}
  </div>
</article>
