<!DOCTYPE html>
<html class="html {{ body_class }} page-{{ post.slug }}" id="theTop" lang="{{ site.language|locale_format }}" {{ site.language_attributes }}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} {{ __('Feed', 'flynt') }}" href="{{ site.rss2 | e('esc_url') }}">
    {{ function('wp_head') }}
  </head>
  <body>
    {% block layout %}
      {# Fixed background grid lines — 5 on mobile, 7 on desktop, aligned to the .boxed container #}
      <div class="backgroundLines" aria-hidden="true">
        <div class="boxed !py-0 h-full flex justify-between lg:hidden">
          {% for i in 1..5 %}<span class="w-px h-full bg-dark-brown/[0.035]"></span>{% endfor %}
        </div>
        <div class="boxed !py-0 h-full hidden lg:flex justify-between">
          {% for i in 1..7 %}<span class="w-px h-full bg-dark-brown/[0.035]"></span>{% endfor %}
        </div>
      </div>
      <div
        class="pageWrapper">
        <header class="w-full">
          {% block header %}
            <div class="wrapper wrapper--menu flex justify-center items-center w-full h-[87px] lg:h-auto fixed top-0 left-0 z-[3000] transition ease-in-out delay-300">
              <div class="hidden lgplus:block w-full">
                {# {{ renderComponent('NavigationMeta') }} #}
                <div class="w-full boxed !max-w-screen-xl !py-0 mx-auto">
                  {{ renderComponent('NavigationMain') }}
                </div>
              </div>
              <div class="block lgplus:hidden w-screen fixed top-0 left-0">
                {{ renderComponent('NavigationBurger') }}
              </div>
              {# <div class="boxed flex flex-row justify-between gap-sm">
                {{ renderComponent('NavigationMain') }}
              </div> #}
            </div>
          {% endblock %}
        </header>
        <main id="mainContent" class="mainContent min-h-screen" aria-label="{{ __('Content', 'flynt') }}">
          <a href="#mainContent" class="skipLink">
            {{ __("Skip to main content", "flynt") }}
          </a>
          {% if function('post_password_required') %}
            {{ function('get_the_password_form') }}
          {% else %}
            {% block content %}
              No <code>{{ '{% block content %}' }}</code> defined for this template.
            {% endblock %}
          {% endif %}
        </main>
        <footer class="mainFooter" id="theFooter">
          {% block footer %}
            {{ renderComponent('NavigationFooter') }}
          {% endblock %}
        </footer>
      </div>
      {{ renderComponent('HighlightCard') }}
    {% endblock %}
    <div class="wpFooter">
      {{ function('wp_footer') }}
    </div>
  </body>
</html>
