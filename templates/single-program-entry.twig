{% extends 'templates/_document.twig' %}

{% block content %}
  {# Bare-bones output of the submitted entry data — style as needed. #}
  <article class="program-entry mt-pageTop boxed max-w-screen-max mx-auto">
    <h1>{{ post.title }}</h1>
    {% if post.meta('intro') %}<p class="intro">{{ post.meta('intro') }}</p>{% endif %}

    {% if post.thumbnail %}
      <img src="{{ post.thumbnail.src }}" alt="{{ post.thumbnail.alt|e|default('') }}">
    {% endif %}

    <dl>
      {% if post.meta('description') %}
        <dt>{{ __('Beschreibung', 'flynt') }}</dt>
        <dd>{{ post.meta('description') }}</dd>
      {% endif %}

      {% if post.meta('orgName') %}
        <dt>{{ __('Organisation', 'flynt') }}</dt>
        <dd>{{ post.meta('orgName') }}</dd>
      {% endif %}

      {% if goalLabels %}
        <dt>{{ __('Thema / Ziele', 'flynt') }}</dt>
        <dd>{{ goalLabels|join(', ') }}</dd>
      {% endif %}

      {% if sectorLabels %}
        <dt>{{ __('Sektor', 'flynt') }}</dt>
        <dd>{{ sectorLabels|join(', ') }}</dd>
      {% endif %}

      {% if programTypeLabels %}
        <dt>{{ __('Art des Programmpunkts', 'flynt') }}</dt>
        <dd>{{ programTypeLabels|join(', ') }}</dd>
      {% endif %}

      {% if formatLabel %}
        <dt>{{ __('Format', 'flynt') }}</dt>
        <dd>{{ formatLabel }}</dd>
      {% endif %}

      {% if audienceLabels %}
        <dt>{{ __('Zielgruppe', 'flynt') }}</dt>
        <dd>{{ audienceLabels|join(', ') }}</dd>
      {% endif %}

      {% if post.meta('language') %}
        <dt>{{ __('Sprache', 'flynt') }}</dt>
        <dd>{{ post.meta('language') }}</dd>
      {% endif %}

      {% if post.meta('dateMode') == 'wunsch' and post.meta('dateFrom') %}
        <dt>{{ __('Termin', 'flynt') }}</dt>
        <dd>
          {{ post.meta('dateFrom') }}{% if post.meta('dateTo') %} – {{ post.meta('dateTo') }}{% endif %}
          {% if post.meta('timeStart') %}, {{ post.meta('timeStart') }}{% if post.meta('timeEnd') %}–{{ post.meta('timeEnd') }}{% endif %}{% endif %}
        </dd>
      {% endif %}

      {% set location = post.meta('location') %}
      {% if post.meta('street') or location.lat %}
        <dt>{{ __('Ort', 'flynt') }}</dt>
        <dd>
          {{ post.meta('street') }}{% if post.meta('postalCode') %}, {{ post.meta('postalCode') }} Berlin{% endif %}
          {% if location.lat %}<br>({{ location.lat }}, {{ location.lng }}){% endif %}
        </dd>
      {% endif %}

      {% if post.meta('mobilityInfo') %}
        <dt>{{ __('Anreise', 'flynt') }}</dt>
        <dd>{{ post.meta('mobilityInfo') }}</dd>
      {% endif %}

      {% if accessibilityLabels %}
        <dt>{{ __('Barrierefreiheit', 'flynt') }}</dt>
        <dd>{{ accessibilityLabels|join(', ') }}</dd>
      {% endif %}

      {% if post.meta('registration') == 'anmeldung' and post.meta('registrationLink') %}
        <dt>{{ __('Anmeldung', 'flynt') }}</dt>
        <dd><a href="{{ post.meta('registrationLink') }}" target="_blank" rel="noopener">{{ post.meta('registrationLink') }}</a></dd>
      {% endif %}

      {% if post.meta('costs') == 'ja' %}
        <dt>{{ __('Kosten', 'flynt') }}</dt>
        <dd>{{ post.meta('price') }}{% if post.meta('paymentLink') %} — <a href="{{ post.meta('paymentLink') }}" target="_blank" rel="noopener">{{ __('Buchung', 'flynt') }}</a>{% endif %}</dd>
      {% endif %}

      {% if post.meta('website') %}
        <dt>{{ __('Website', 'flynt') }}</dt>
        <dd><a href="{{ post.meta('website') }}" target="_blank" rel="noopener">{{ post.meta('website') }}</a></dd>
      {% endif %}
    </dl>
  </article>
{% endblock %}
