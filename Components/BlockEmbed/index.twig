<flynt-component
  load:on="visible"
  name="BlockEmbed">
  <div
    class="boxed">
    <div
      class="
        wysiwyg flex flex-col
        {% if textPosition == 'right' %} justify-end w-full lg:w-[calc(75%_-_12.5px)] ml-auto{% endif %}
        {% if textPosition == 'left' %} justify-start w-full lg:w-[calc(75%_-_12.5px)] mr-auto{% endif %}
        {% if textPosition == 'center_narrow' %} justify-center w-full md:w-2/3 mx-auto{% endif %}
        {% if textPosition == 'center_full' %} justify-center w-full mx-auto{% endif %}
      "
      style="
        background-color: {% if options.colorBackground %}{{ options.colorBackground }}{% else %}transparent{% endif %};">
      {% if contentHtml %}
        {{ contentHtml|e('wp_kses_post') }}
      {% endif %}
      {% if embedHtml %}
        {# Raw output on purpose: embed codes (iframes, provider scripts) would not survive escaping. #}
        <div class="embed{% if fluidEmbed %} embed--fluid{% endif %}{% if textPosition starts with 'center' %} embed--center{% endif %}">
          {{ embedHtml|raw }}
        </div>
      {% endif %}
      {% if buttonLink %}
        <a
          class="button button--outline"
          href="{{ buttonLink.url }}"
          {% if buttonLink.target %} target="{{ buttonLink.target }}" rel="noreferrer noopener"{% endif %}>
          {{ buttonLink.title }}
        </a>
      {% endif %}
    </div>
  </div>
</flynt-component>
