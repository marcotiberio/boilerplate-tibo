{% set mobileImage = imageMobile ?: image %}
<flynt-component
  name="HeroImage"
  class="hero hero--{{ height|default('tall') }} relative flex items-end overflow-hidden bg-forest text-white">
  {% if image %}
    <picture class="absolute inset-0">
      <source media="(min-width: 780px)" srcset="{{ image.src|e('html_attr') }}">
      <img
        class="w-full h-full object-cover"
        src="{{ mobileImage.src|e('html_attr') }}"
        alt="{{ image.alt|e('html_attr') }}"
        fetchpriority="high"
        loading="eager">
    </picture>
  {% endif %}
  <div class="absolute inset-0 bg-forest/50" aria-hidden="true"></div>

  <div class="content pb-xxl pt-max">
    {% if label %}
      <p class="eyebrow">{{ label|e }}</p>
    {% endif %}
    <h1 class="hero-title uppercase !mb-0 max-w-[44rem]">{{ title|e('wp_kses_post') }}</h1>
    {% if intro %}
      <p class="hero-intro mt-sm !mb-0 max-w-[50rem]">{{ intro|e }}</p>
    {% endif %}
    {% include 'templates/partials/_buttons.twig' with { buttons: buttons, class: 'mt-md' } only %}
  </div>

  <div class="hero-topo topo" aria-hidden="true"></div>
</flynt-component>
