<flynt-component load:on="idle" name="NavigationMain" class="w-full">
  <nav
    aria-label="{{ labels.ariaLabel|e }}"
    class="relative flex flex-row items-center justify-between gap-sm my-xs px-xs py-min rounded-banner bg-white shadow-[0_18px_5.5px_rgba(0,0,0,0.02),0_8px_4px_rgba(0,0,0,0.03),0_2px_2px_rgba(0,0,0,0.03)]">

    {# Pale-green tint (moss 30% over the white pill) #}
    <span aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[inherit] bg-moss/30"></span>

    <div class="relative flex flex-row items-center min-w-0">
      {% include 'Partials/_logo.twig' with { 'logo': logo, 'site': site } only %}
    </div>

    <div class="relative flex flex-row items-center gap-sm">
      {% if menu %}
        {% include 'Partials/_menu.twig' with { 'items': menu.items } only %}
      {% endif %}

      <div class="flex flex-row items-center gap-min shrink-0">
        {% if ctaLink %}
          <a
            class="button button--donate"
            href="{{ ctaLink.url }}"
            {% if ctaLink.target %} target="{{ ctaLink.target }}" rel="noreferrer noopener"{% endif %}>
            <span>{{ ctaLink.title }}</span>
          </a>
        {% endif %}
        {% if secondaryLink %}
          <a
            class="button button--shop"
            href="{{ secondaryLink.url }}"
            {% if secondaryLink.target %} target="{{ secondaryLink.target }}" rel="noreferrer noopener"{% endif %}>
            <span>{{ secondaryLink.title }}</span>
          </a>
        {% endif %}
      </div>
    </div>
  </nav>
</flynt-component>
