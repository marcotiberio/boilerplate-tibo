<flynt-component load:on="idle" name="NavigationMain" class="w-full flex justify-start items-center">
  <nav class="navigation z-[99] w-full py-sm" aria-label="{{ labels.ariaLabel|e }}">
    <div class="flex flex-row items-center justify-between gap-lg h-full w-full">
      <div class="flex flex-row gap-lg items-center min-w-0">
        {% include 'Partials/_logo.twig' with { 'logo': logo, 'site': site } only %}
        {% if menu %}
          {% include 'Partials/_menu.twig' with { 'items': menu.items } only %}
        {% endif %}
      </div>
      <div class="flex flex-row gap-sm items-center shrink-0">
        <a
          href="{{ function('get_search_link') }}"
          aria-label="{{ __('Suche', 'flynt') }}"
          class="flex items-center justify-center w-11 h-11 rounded-full bg-beige text-dark-green hover:bg-moss transition-colors">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M11 11L14.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        {% if ctaLink %}
          <a
            class="button button--fullOrange"
            href="{{ ctaLink.url }}"
            {% if ctaLink.target %} target="{{ ctaLink.target }}" rel="noreferrer noopener"{% endif %}>
            {{ ctaLink.title }}
          </a>
        {% endif %}
      </div>
    </div>
  </nav>
</flynt-component>
