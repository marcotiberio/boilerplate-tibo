<flynt-component load:on="idle" name="NavigationMain" class="w-full flex justify-start items-center">
  <nav class="navigation z-[99] w-full" aria-label="{{ labels.ariaLabel|e }}">
    <div class="flex flex-row items-center justify-between gap-lg h-full w-full">
      <div class="flex flex-row gap-xs items-center w-full">
        {% include 'Partials/_logo.twig' with { 'logo': logo, 'site': site, 'categoryColor': categoryColor } only %}
        {% if menu %}
          {% include 'Partials/_menu.twig' with { 'items': menu.items } only %}
        {% endif %}
        <div class="relative flex items-center gap-xs">
          {% if ctaMenu %}
            {% include 'Partials/_menuCta.twig' with { 'items': ctaMenu.items } only %}
          {% endif %}
          <div data-nav-slot="projectFilters" class=""></div>
        </div>
      </div>
    </div>
  </nav>
</flynt-component>
