<flynt-component
  name="BlockImageText"
  class="section section--{{ options.sectionTheme|default('mist') }} {{ options.decoration == 'topo' ? 'decoration--topo' }}">
  <div class="content">
    {% include 'templates/partials/_heading.twig' with { title: title } only %}
    <div class="flex flex-col {{ imagePosition == 'right' ? 'lg:flex-row-reverse' : 'lg:flex-row' }} gap-md lg:gap-lg items-center">
      {% if image %}
        <figure class="w-full lg:w-1/2 m-0">
          {% if image.post_mime_type == 'image/svg+xml' %}
            <img class="w-full h-auto" src="{{ image.src|e('html_attr') }}" alt="{{ image.alt|e('html_attr') }}" loading="lazy">
          {% else %}
            <img
              class="lazyload w-full h-full object-cover aspect-4/3"
              src="{{ image.src|resize(32) }}"
              data-srcset="{{ function('wp_get_attachment_image_srcset', image.id) }}"
              data-sizes="auto"
              alt="{{ image.alt|e('html_attr') }}">
          {% endif %}
          {% if image.caption %}
            <figcaption class="meta">{{ image.caption|e }}</figcaption>
          {% endif %}
        </figure>
      {% endif %}
      <div class="w-full {{ image ? 'lg:w-1/2' }} flex flex-col">
        {% if contentHtml %}
          <div class="wysiwyg blockImageText-text">{{ contentHtml|e('wp_kses_post') }}</div>
        {% endif %}
        {% include 'templates/partials/_buttons.twig' with { buttons: buttons, class: 'mt-sm' } only %}
      </div>
    </div>
  </div>
</flynt-component>
