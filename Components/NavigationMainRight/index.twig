<flynt-component name="NavigationMainRight" class="flex justify-end items-center">
  <nav class="navigation" aria-label="{{ labels.ariaLabel|e('html_attr') }}">
    <div class="flex flex-row items-center gap-md">
      {% if menu %}
        {% include 'Partials/_menu.twig' with { 'items': menu.items } only %}
      {% endif %}
      {% if ctaLink %}
        <a
          class="button button--forest"
          href="{{ ctaLink.url|e('esc_url') }}"
          {% if ctaLink.target %}target="{{ ctaLink.target|e('html_attr') }}" rel="noopener noreferrer"{% endif %}>
          {{ ctaLink.title|e }}
        </a>
      {% endif %}
    </div>
  </nav>
</flynt-component>
