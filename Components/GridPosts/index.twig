<flynt-component name="GridPosts" class="w-full">
  <div class="boxed{% if isArchive %} pt-xxl lg:pt-max{% endif %} flex flex-col gap-lg">
    {% if title %}
      {% set tag = titleTag|default('h2') %}
      <{{ tag }} class="font-{{ titleSize|default('h2') }} text-dark-brown">{{ title }}</{{ tag }}>
    {% endif %}

    {% if cards %}
      <div class="grid grid-cols-1 md:grid-cols-2 desktop:grid-cols-3 gap-sm">
        {% for card in cards %}
          {{ include('Components/SliderCards/Partials/_card.twig', { card: card, source: 'projects', options: {} }, with_context = false) }}
        {% endfor %}
      </div>
    {% else %}
      <p class="font-body text-muted-black">{{ __('Noch keine News.', 'flynt') }}</p>
    {% endif %}

    {% if pagination and pagination.pages|length > 1 %}
      <nav class="flex flex-wrap items-center justify-center gap-min" aria-label="{{ __('Seiten', 'flynt') }}">
        {% if pagination.prev %}
          <a class="font-body !mb-0 pagination-link" href="{{ pagination.prev.link }}" aria-label="{{ __('Vorherige Seite', 'flynt') }}">‹</a>
        {% endif %}
        {% for page in pagination.pages %}
          {% if page.link %}
            <a class="font-body !mb-0 pagination-link" href="{{ page.link }}">{{ page.title }}</a>
          {% else %}
            <span class="font-body !mb-0 pagination-link{% if page.current %} is-current{% endif %}" {% if page.current %}aria-current="page"{% endif %}>{{ page.title }}</span>
          {% endif %}
        {% endfor %}
        {% if pagination.next %}
          <a class="font-body !mb-0 pagination-link" href="{{ pagination.next.link }}" aria-label="{{ __('Nächste Seite', 'flynt') }}">›</a>
        {% endif %}
      </nav>
    {% endif %}
  </div>
</flynt-component>
