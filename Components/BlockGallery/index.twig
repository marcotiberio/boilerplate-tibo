<flynt-component
  load:on="visible"
  name="BlockGallery">
  <div
    class="boxed flex flex-col gap-sm md:gap-md"
    x-data="{ open: false, src: '', alt: '' }"
    x-effect="document.body.style.overflow = open ? 'hidden' : ''"
    @keydown.escape.window="open = false">
    {% if preContent %}
      <h2 class="font-h1 !mb-0">{{ preContent|e }}</h2>
    {% endif %}
    <div class="columns-1 md:columns-2 lg:columns-3 gap-sm md:gap-md">
      {% for image in images %}
        <figure class="break-inside-avoid mb-sm md:mb-md m-0" id="image-{{ loop.index }}">
          <button
            type="button"
            data-src="{{ function('wp_get_attachment_image_url', image.id, 'large') }}"
            data-alt="{{ image.alt | default('') }}"
            class="block w-full p-0 border-0 bg-transparent cursor-zoom-in transition-opacity hover:opacity-80"
            @click="open = true; src = $el.dataset.src; alt = $el.dataset.alt"
            aria-label="{{ __('Open image', 'flynt') }}">
            <img
              class="w-full h-auto object-cover"
              src="{{ image.src }}"
              srcset="{{ function('wp_get_attachment_image_srcset', image.id) }}"
              sizes="(min-width: 1024px) 33vw, (min-width: 780px) 50vw, 100vw"
              alt="{{ image.alt|e | default('') }}"
              loading="lazy"
            />
          </button>
        </figure>
      {% endfor %}
    </div>

    <div
      x-show="open"
      x-transition.opacity
      x-cloak
      @click="open = false"
      class="fixed inset-0 z-[9999] bg-white flex items-center justify-center p-sm cursor-zoom-out">
      <button
        type="button"
        class="absolute top-sm right-sm text-white text-4xl leading-none cursor-pointer"
        @click="open = false"
        aria-label="{{ __('Close', 'flynt') }}">&times;</button>
      <img
        :src="src"
        :alt="alt"
        class="max-w-full max-h-full object-contain">
    </div>
  </div>
</flynt-component>
