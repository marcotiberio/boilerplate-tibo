{% if projects|length > 0 %}
  <flynt-component
    load:on="visible"
    name="ListingProjects"
    class="w-full"
    style="
      color: {% if options.colorText %}{{ options.colorText }}{% else %}var(--black){% endif %};
      background-color: {% if options.colorBackground %}{{ options.colorBackground }}{% else %}transparent{% endif %};">
    <div
      class="boxed flex flex-col gap-sm {% if options.topBorder %}border-t-2 border-black mt-sm{% endif %}"
      x-data
    >

      {# Header: Title + See All #}
      {% if blockTitle or seeAllLink %}
        <div class="flex flex-row items-center justify-between">
          {% if blockTitle %}
            <h2 class="font-h1Serif !mb-0">{{ blockTitle|e }}</h2>
          {% endif %}
          {% if seeAllLink %}
            <a href="{{ seeAllLink.url }}" class="see-all-button flex flex-row items-center gap-xs font-body hover:opacity-70 transition-opacity" {% if seeAllLink.target %}target="{{ seeAllLink.target }}"{% endif %}>
              <svg width="32" height="22" viewBox="0 0 32 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M19.0322 21.2399C18.8242 21.2399 18.6562 21.1839 18.5282 21.0719C18.4002 20.9439 18.3362 20.7999 18.3362 20.6399C18.3522 20.5599 18.3682 20.4639 18.3842 20.3519C18.4642 20.0479 18.5682 19.7119 18.6962 19.3439L21.5522 11.7119L3.91222 12.9839C2.56822 13.1279 1.57622 12.9839 0.936215 12.5519C0.312215 12.1039 0.000214994 11.4639 0.000214994 10.6319C0.000214994 9.79987 0.320215 9.15987 0.960215 8.71187C1.61622 8.24787 2.60022 8.09587 3.91222 8.25587L21.5282 9.50387L18.6962 1.87187C18.5682 1.56787 18.4722 1.31187 18.4082 1.10387C18.3602 0.895866 18.3362 0.727866 18.3362 0.599865C18.3362 0.439866 18.4002 0.303866 18.5282 0.191866C18.6562 0.0638661 18.8242 -0.000133991 19.0322 -0.000133991C19.3682 -0.000133991 19.6802 0.119866 19.9682 0.359866L31.1522 9.59987C31.3442 9.75987 31.4882 9.91987 31.5842 10.0799C31.6802 10.2239 31.7282 10.3999 31.7282 10.6079C31.7282 10.7999 31.6802 10.9759 31.5842 11.1359C31.5042 11.2959 31.3602 11.4639 31.1522 11.6399L19.9682 20.8799C19.6802 21.1199 19.3682 21.2399 19.0322 21.2399Z" fill="black"/>
              </svg>
            </a>
          {% endif %}
        </div>
      {% endif %}

      {# Filters (portaled into NavigationMain at lg+) #}
      {% if categories|length > 0 or locations|length > 0 %}
        <div
          data-listing-filters
          data-category-colors="{{ categoryColors|json_encode|e('html_attr') }}"
          class="flex flex-col lg:flex-row gap-min md:gap-xs items-stretch lg:items-center md:ml-xs w-full lg:w-auto"
          x-init="
            $store.projectFilters.setCategoryColors(JSON.parse($el.dataset.categoryColors));
            $nextTick(() => {
              const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
              const selector = isDesktop ? '[data-nav-slot=&quot;projectFilters&quot;]' : '[data-nav-slot=&quot;projectFiltersMobile&quot;]';
              const slot = document.querySelector(selector);
              if (!slot) return;
              slot.appendChild($el);
            })
          "
        >
          {% if categories|length > 0 %}
            <div x-data="{ open: false }" @click.outside="open = false" class="relative w-full lg:w-auto">
              <button
                type="button"
                class="border rounded-button bg-white py-min px-xs w-full lg:min-w-[180px] !font-body !mb-0 cursor-pointer no-invert inline-flex items-center justify-between gap-xs"
                :aria-expanded="open"
                @click="open = !open"
              >
                <span>Pillars</span>
                <svg class="w-auto h-auto transition-transform duration-200 shrink-0" :class="open ? 'rotate-180' : ''" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 6L8 10L12 6" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div
                x-show="open"
                x-transition.opacity
                x-cloak
                class="absolute top-full left-0 mt-min flex flex-col gap-min items-start z-10 w-full"
              >
                {% for slug, name in categories %}
                  {% set color = categoryColors[slug]|default('#000000') %}
                  <button
                    class="border rounded-button bg-white py-min px-xs min-w-full md:min-w-[180px] !font-body !mb-0 cursor-pointer transition-opacity no-invert inline-flex items-center justify-between gap-xs"
                    x-on:click="$store.projectFilters.toggleCategory('{{ slug }}')"
                  >
                    <span>{{ name }}</span>
                    <span
                      class="block w-[18px] h-[18px] rounded-full border border-black transition-colors"
                      :style="$store.projectFilters.activeCategory.includes('{{ slug }}') ? 'background-color: {{ color }}; border-color: {{ color }};' : ''"
                    ></span>
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          {% if locations|length > 0 %}
            <div x-data="{ open: false }" @click.outside="open = false" class="relative w-full lg:w-auto">
              <button
                type="button"
                class="border rounded-button bg-white py-min px-xs w-full lg:min-w-[180px] !font-body !mb-0 cursor-pointer no-invert inline-flex items-center justify-between gap-xs"
                :aria-expanded="open"
                @click="open = !open"
              >
                <span>City</span>
                <svg class="w-auto h-auto transition-transform duration-200 shrink-0" :class="open ? 'rotate-180' : ''" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 6L8 10L12 6" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div
                x-show="open"
                x-transition.opacity
                x-cloak
                class="absolute top-full left-0 mt-min flex flex-col gap-min items-start z-10 w-full"
              >
                {% for slug, name in locations %}
                  <button
                    class="border rounded-button bg-white py-min px-xs min-w-full md:min-w-[180px] !font-body !mb-0 cursor-pointer transition-opacity no-invert inline-flex items-center justify-between gap-xs"
                    x-on:click="$store.projectFilters.toggleLocation('{{ slug }}')"
                  >
                    <span>{{ name }}</span>
                    <span
                      class="block w-[18px] h-[18px] rounded-full border border-black transition-colors"
                      :class="$store.projectFilters.activeLocation.includes('{{ slug }}') ? 'bg-black' : ''"
                    ></span>
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <button
            type="button"
            class="border rounded-button py-min px-xs w-full lg:w-auto lg:min-w-[180px] bg-grey text-black border-grey !font-body !mb-0 cursor-pointer no-invert transition-opacity inline-flex items-center justify-between gap-xs"
            :class="($store.projectFilters.activeCategory.length === 0 && $store.projectFilters.activeLocation.length === 0) ? 'opacity-40 pointer-events-none' : ''"
            @click="$store.projectFilters.reset()"
          >
            <span>{{ options.resetLabel|default('Reset all') }}</span>
            <svg class="w-auto h-auto shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 4L12 12M12 4L4 12" stroke="#000" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      {% endif %}

      {# Projects Grid #}
      <div class="grid grid-cols-1 tablet:grid-cols-2 desktop:grid-cols-3 gap-sm">
        {% for item in projects %}
          {% set project = item.project %}
          <a
            href="{{ project.link }}"
            class="group flex flex-col gap-xs no-underline"
            style="--cat-color: {{ item.categoryColor ?: '#00c351' }};"
            title="{{ project.title }}"
            aria-label="Go to project"
            x-show="$store.projectFilters.matchFilter($store.projectFilters.activeCategory, {{ item.categorySlugs|json_encode|e('html_attr') }}) && $store.projectFilters.matchFilter($store.projectFilters.activeLocation, {{ item.locationSlugs|json_encode|e('html_attr') }})"
            x-transition:enter="transition-opacity duration-200"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition-opacity duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
          >

            {# Featured Media #}
            <div class="relative w-full aspect-4/3 overflow-hidden border-2 border-transparent group-hover:border-[var(--cat-color)] transition-colors duration-200">
              {% if project.thumbnail %}
                <img
                  class="figure-image lazyload w-full h-full object-cover"
                  src="{{ project.thumbnail.src }}"
                  alt="{{ project.thumbnail.alt|e | default('') }}"
                  loading="lazy"
                />
              {% endif %}
            </div>

            {# Info Box #}
            <div class="flex flex-col">
              <div class="flex flex-row justify-between gap-xs">
                <div class="">
                  {% if project.dateStart %}
                    <span class="font-h3Regular !mb-0">{{ project.dateStart('d.m.Y') }} - </span>
                  {% endif %}
                  {% if project.dateEnd %}
                    <span class="font-h3Regular !mb-0">{{ project.dateEnd('d.m.Y') }}</span>
                  {% endif %}
                </div>
                {% if project.postLocation %}
                  <div class="font-h3Regular !mb-0">{{ project.postLocation }}</div>
                {% endif %}
              </div>
              <div class="mb-min transition-colors duration-200 group-hover:text-[var(--cat-color)]"><span class="!mb-0 font-h2">{{ project.postArtist }} – </span><span class="!mb-0 font-h2Regular">{{ project.title }}</span></div>
              {% if project.postDescription %}
                <span class="font-bodySmall !mb-0">{{ project.postDescription|split('.')|first ~ '.' }}</span>
              {% endif %}
            </div>

          </a>
        {% endfor %}
      </div>

    </div>
  </flynt-component>
{% endif %}
