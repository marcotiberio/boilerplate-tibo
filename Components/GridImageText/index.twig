{% set columnClasses = {
  '2': 'md:grid-cols-2',
  '3': 'md:grid-cols-2 lg:grid-cols-3',
  '4': 'md:grid-cols-2 lg:grid-cols-4'
} %}
{% set isCards = options.look == 'cards' %}
<flynt-component
  name="GridImageText"
  class="section section--{{ options.sectionTheme|default('mist') }} {{ options.decoration == 'topo' ? 'decoration--topo' }}">
  <div class="content">
    {% include 'templates/partials/_heading.twig' with { title: headlineTitle, description: intro } only %}
    {% if items %}
      <ul class="grid grid-cols-1 {{ columnClasses[options.gridColumns|default('4')] }} {{ isCards ? 'gap-sm' : 'gap-md' }} list-none p-0 m-0">
        {% for item in items %}
          <li class="gridImageText-item flex flex-col gap-xs {{ isCards ? 'gridImageText-item--card bg-forest text-white p-sm' : 'gridImageText-item--column pt-xs' }}">
            {% if item.image %}
              <figure class="m-0 mb-xs">
                {% if item.image.post_mime_type == 'image/svg+xml' %}
                  <img class="w-full h-auto" src="{{ item.image.src|e('html_attr') }}" alt="{{ item.image.alt|e('html_attr') }}" loading="lazy">
                {% else %}
                  <img
                    class="lazyload w-full aspect-16/10 object-cover"
                    src="{{ item.image.src|resize(32) }}"
                    data-srcset="{{ function('wp_get_attachment_image_srcset', item.image.id) }}"
                    data-sizes="auto"
                    alt="{{ item.image.alt|e('html_attr') }}">
                {% endif %}
              </figure>
            {% endif %}
            {% if item.label %}
              <p class="meta w-fit !mb-0 px-xs py-min {{ isCards ? 'bg-sage text-forest' : 'bg-sage-light' }}">{{ item.label|e }}</p>
            {% endif %}
            {% if item.title %}
              <h3 class="gridImageText-title uppercase !mb-0">{{ item.title|e }}</h3>
            {% endif %}
            {% if item.contentHtml %}
              <div class="wysiwyg">{{ item.contentHtml|e('wp_kses_post') }}</div>
            {% endif %}
            {% if item.footnote or item.itemLink %}
              <div class="flex flex-col gap-xs mt-auto pt-xs">
                {% if item.footnote %}
                  <p class="meta !mb-0">{{ item.footnote|e }}</p>
                {% endif %}
                {% if item.itemLink %}
                  <a
                    class="{{ isCards ? 'button button--white' : 'meta underline underline-offset-4' }}"
                    href="{{ item.itemLink.url|e('esc_url') }}"
                    {% if item.itemLink.target %}target="{{ item.itemLink.target|e('html_attr') }}" rel="noopener noreferrer"{% endif %}>
                    {{ item.itemLink.title|e }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</flynt-component>
