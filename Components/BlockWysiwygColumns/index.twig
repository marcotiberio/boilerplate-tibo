{% set colCount = options.columnCount|default('2') %}
{% set colGrid = {
  '1': 'md:grid-cols-1',
  '2': 'md:grid-cols-2',
  '3': 'md:grid-cols-2 lg:grid-cols-3'
}[colCount]|default('md:grid-cols-2') %}

<flynt-component
  load:on="visible"
  name="BlockWysiwygColumns"
  class="w-full"
  style="{% if options.colorBackground %}background-color: {{ options.colorBackground }};{% endif %}">
  <div class="boxed py-xl">
    <div class="grid grid-cols-1 {{ colGrid }} gap-x-lg gap-y-md">
      {% for column in columns %}
        <div class="flex flex-col items-start gap-sm">
          {% if column.contentHtml %}
            <div class="wysiwyg {% if column.listStyle == 'checklist' %}wysiwyg--checklist{% endif %} text-black">{{ column.contentHtml|e('wp_kses_post') }}</div>
          {% endif %}

          {% if column.button %}
            <a
              class="button button--primary"
              href="{{ column.button.url }}"
              {% if column.button.target %} target="{{ column.button.target }}" rel="noreferrer noopener"{% endif %}>
              <span>{{ column.button.title }}</span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</flynt-component>
