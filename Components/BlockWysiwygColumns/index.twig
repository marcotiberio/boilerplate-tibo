<flynt-component 
  load:on="visible" 
  name="BlockWysiwygColumns"
  class="{% if options.firstComponent %}pt-[10vw] md:pt-[160px]{% endif %}"
  style="
    background-color: {% if options.colorBackground %}{{ options.colorBackground }}{% else %}transparent{% endif %};"
  >
  <div class="boxed w-full">
    {# <div class="block lg:hidden">
      <h2>{{ headlineTitle|e }}</h2>
    </div> #}
    <div class="flex flex-col md:flex-row gap-sm">
      <div
        class="flex flex-col w-full"
        style="flex-basis: {{ leftColumnWidth|default(66) }}%;"
      >
        {% if leftColumnContentHtml %}
          <div class="wysiwyg">{{ function('do_shortcode', leftColumnContentHtml)|raw }}</div>
        {% endif %}
      </div>
      <div
        class="flex flex-col w-full"
        style="flex-basis: {{ rightColumnWidth|default(33) }}%;"
      >
        {% if rightColumnContentHtml %}
          <div class="wysiwyg">{{ function('do_shortcode', rightColumnContentHtml)|raw }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</flynt-component> 