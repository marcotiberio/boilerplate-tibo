{% set colCount = options.columnCount|default('2') %}
{# Default span (out of 12) when a column's width is set to Inherit #}
{% set defaultSpan = {
  '1': 'md:col-span-12',
  '2': 'md:col-span-6',
  '3': 'md:col-span-4'
}[colCount]|default('md:col-span-6') %}
{# Per-column width override #}
{% set spanMap = {
  'third': 'md:col-span-4',
  'half': 'md:col-span-6',
  'full': 'md:col-span-12'
} %}

<flynt-component
  load:on="visible"
  name="BlockWysiwygColumns"
  class="w-full"
  style="{% if options.colorBackground %}background-color: {{ options.colorBackground }};{% endif %}">
  <div class="boxed py-xl">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-x-lg gap-y-md">
      {% for column in columns %}
        <div class="flex flex-col items-start gap-sm {{ spanMap[column.width]|default(defaultSpan) }}">
          {% if column.contentHtml %}
            <div class="wysiwyg {% if column.listStyle == 'checklist' %}wysiwyg--checklist{% endif %} text-black">{{ column.contentHtml|e('wp_kses_post') }}</div>
          {% endif %}

          {% if column.button %}
            <a
              class="button button--primary"
              href="{{ column.button.url }}"
              {% if column.button.target %} target="{{ column.button.target }}" rel="noreferrer noopener"{% endif %}>
              <span>{{ column.button.title }}</span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</flynt-component>
