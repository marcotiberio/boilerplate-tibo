{# Related program entries below a single event.
   Params: post (required), title, buttonLabel, programLink #}
{% if events %}
  <flynt-component load:on="visible" name="BlockRelatedEvents" class="relative block w-full bg-white text-black">
    <div class="mx-auto flex w-full max-w-screen-lgplus flex-col gap-8 px-4 pb-8 tablet:px-8">

      {% if title %}
        <h2 class="m-0 text-[22px] font-medium leading-none desktop:text-[24px]">{{ title }}</h2>
      {% endif %}

      <div class="flex flex-col items-center gap-16">
        <div class="grid w-full grid-cols-1 gap-5 tablet:grid-cols-2 desktop:grid-cols-3">
          {% for event in events %}
            {% include 'templates/Partials/_eventCard.twig' with { event: event } only %}
          {% endfor %}
        </div>

        {% if programLink %}
          <a
            class="flex w-fit items-center justify-center gap-3 rounded bg-green px-[18px] py-2 text-[20px] font-semibold leading-none text-black no-underline transition-colors duration-200 ease-in-out hover:bg-greenFaded"
            href="{{ programLink }}">
            {{ buttonLabel }}
            <span class="flex h-[33px] w-[33px] shrink-0 items-center justify-center rounded-full bg-white" aria-hidden="true">
              <span class="flex h-[18px] w-[18px] items-center justify-center [&_svg]:h-full [&_svg]:w-full">
                {% include 'assets/icons/event/button-arrow.svg' ignore missing %}
              </span>
            </span>
          </a>
        {% endif %}
      </div>

    </div>
  </flynt-component>
{% endif %}
