<flynt-component name="NavigationFooter" class="navigationFooter relative bg-mist text-ink overflow-hidden">
  <div class="content grid grid-cols-1 md:grid-cols-[2fr_2fr_1fr] gap-md pt-xl pb-lg">
    {% if menu and menu.items %}
      <nav aria-label="{{ labels.ariaLabel|e('html_attr') }}">
        {% if menuTitle %}
          <p class="navigationFooter-title uppercase !mb-xs">{{ menuTitle|e }}</p>
        {% endif %}
        <ul class="navigationFooter-menu list-none p-0 m-0 grid grid-cols-2 grid-rows-3 grid-flow-col gap-x-md gap-y-min">
          {% for item in menu.items %}
            <li>
              <a class="meta underline underline-offset-4 hover:no-underline" href="{{ item.link|e('esc_url') }}" {{ item.target == '_blank' ? 'target="_blank" rel="noopener noreferrer"' }}>{{ item.title|e }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    {% if contactHtml %}
      <div>
        {% if contactTitle %}
          <p class="navigationFooter-title uppercase !mb-xs">{{ contactTitle|e }}</p>
        {% endif %}
        <address class="wysiwyg navigationFooter-contact not-italic">{{ contactHtml|e('wp_kses_post') }}</address>
      </div>
    {% endif %}

    {% if instagramUrl or linkedinUrl %}
      <ul class="list-none p-0 m-0 flex flex-row gap-xs md:justify-end md:items-start">
        {% if instagramUrl %}
          <li>
            <a class="navigationFooter-social" href="{{ instagramUrl|e('esc_url') }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              {% include 'assets/icons/instagram.svg' ignore missing %}
            </a>
          </li>
        {% endif %}
        {% if linkedinUrl %}
          <li>
            <a class="navigationFooter-social" href="{{ linkedinUrl|e('esc_url') }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              {% include 'assets/icons/linkedin.svg' ignore missing %}
            </a>
          </li>
        {% endif %}
      </ul>
    {% endif %}
  </div>

  <div class="navigationFooter-landscape" aria-hidden="true"></div>
</flynt-component>
