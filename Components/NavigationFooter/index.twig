<flynt-component load:on="visible" name="NavigationFooter" class="bg-white text-black mt-xs">
  <div class="boxed !min-h-fit flex flex-row justify-between items-end">
    <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1.5fr_1fr_0.5fr] py-md gap-md sm:gap-lg border-t border-black">
      {# Row 1 #}
      <div class="w-full">
        {% if logoFooter %}
          <img class="lazyload h-auto w-[100px]"
            src="{{ logoFooter.src }}"
            data-srcset="{{function('wp_get_attachment_image_srcset', logoFooter.id)}}"
            data-sizes="auto">
        {% endif %}
      </div>
      {# Row 2 #}
      <div class="flex flex-row gap-sm justify-between">
        {% for column in columns %}
          <div class="column flex flex-col">
            <div class="wysiwyg">{{ column.contentHtml|e('wp_kses_post') }}</div>
          </div>
        {% endfor %}
      </div>
      {# {% if menu %}
      <div class="w-full">
        <nav class="navigation w-full flex justify-start lg:justify-center items-end" aria-label="{{ labels.ariaLabel }}">
          {% include 'Partials/_menu.twig' with { 'items': menu.get_items, 'level': '0', 'maxLevel': maxLevel } only %}
        </nav>
      </div>
      {% endif %} #}
      <div class="w-full justify-start items-center gap-sm">
        <div class="flex flex-row items-center">
          <div class="wysiwyg">{{ function('do_shortcode', copyrightsHtml)|raw }}</div>
        </div>
      </div>

      {# Social Links #}
      {% if socialLinks %}
        <div class="w-full flex justify-start md:justify-end items-start">
          <ul class="social-links flex flex-row flex-wrap gap-sm" aria-label="{{ __('Social media', 'flynt') }}">
            {% for link in socialLinks %}
              <li class="social-links__item">
                <a class="social-links__link inline-flex items-center justify-center bg-black rounded-[5px] w-[40px] h-[40px] transition-opacity hover:opacity-70"
                   href="{{ link.url }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="{{ link.label }}">
                  <img class="social-links__icon w-[25px] h-[25px] invert"
                       src="{{ link.iconUrl }}"
                       alt=""
                       width="20"
                       height="20"
                       loading="lazy"
                       decoding="async">
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {# Col 5 #}
      {# <div class="w-full lg:w-1/5 flex flex-col gap-sm sm:gap-lg justify-start sm:justify-end items-start sm:items-end mb-[1.2rem]">
