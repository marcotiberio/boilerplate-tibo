<flynt-component load:on="visible" name="NavigationFooter" class="relative block">

  {# ───────────────────────── Newsletter ───────────────────────── #}
  <section class="relative overflow-hidden min-h-[100vh] md:min-h-[50vh] lg:min-h-[50vh]">
    {# Decorative acacia silhouette bridging into the footer #}
    <div class="block absolute right-0 bottom-[-55px] md:w-[40%] max-w-[375px] text-dark-green pointer-events-none select-none [&>svg]:w-full [&>svg]:h-auto" aria-hidden="true">
      {% include 'assets/images/footer-forest.svg' ignore missing %}
    </div>

    <div class="boxed relative z-10 py-xl">
      <div class="flex flex-col md:flex-row items-start gap-sm sm:gap-md lg:gap-xl max-w-[900px]">
        {# Image + mail badge #}
        {% if newsletterImage %}
          <div class="relative shrink-0">
            <img
              class="w-full aspect-[16/7] md:aspect-square md:max-w-[216px] object-cover rounded-card"
              src="{{ newsletterImage.src }}" alt="{{ newsletterImage.alt|e|default('') }}" loading="lazy">
            <span class="absolute -top-xs -right-xs md:-top-sm md:-right-sm w-14 h-14 rounded-cta bg-moss flex items-center justify-center text-dark-green [&_svg]:w-8 [&_svg]:h-8 [&_svg]:fill-current">
              {% include 'assets/icons/email-full.svg' ignore missing %}
            </span>
          </div>
        {% endif %}

        {# Heading + form #}
        <div class="flex flex-col gap-sm w-full max-w-[539px]">
          {% if newsletterHeading %}
            <p class="font-h5 text-black">{{ newsletterHeading }}</p>
          {% endif %}

          {# NOTE: markup only — no ESP wired yet. onsubmit prevented so nothing is sent. #}
          <form class="flex flex-col sm:flex-row gap-xs w-full" onsubmit="return false;"
            aria-label="{{ newsletterHeading|e|default('Newsletter') }}">
            <label class="sr-only" for="footer-nl-email">{{ newsletterPlaceholder|e }}</label>
            <input
              id="footer-nl-email" type="email" name="email"
              class="flex-1 h-auto px-sm rounded-cta border-0 bg-warmer-beige/50 text-dark-brown placeholder:text-dark-brown/60 focus:outline-none focus:ring-2 focus:ring-jungle/40"
              placeholder="{{ newsletterPlaceholder|e }}">
            <button type="submit" class="button button--jungle !w-full sm:!w-auto">{{ newsletterButtonLabel|e|default('Anmelden') }}</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  {# ───────────────────────── Main footer (dark green) ───────────────────────── #}
  <section class="relative bg-dark-green text-off-white">
    {# Wave that lifts the dark-green panel into the off-white newsletter above #}
    <svg class="absolute left-0 bottom-full w-full h-[60px] lg:h-[120px] block pointer-events-none" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path fill="#113328" d="M0,120 L0,64 C240,16 480,0 720,24 C960,48 1200,96 1440,64 L1440,120 Z"></path>
    </svg>

    <div class="boxed pt-xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-lg">

        {# Brand & Contact #}
        <div class="flex flex-col gap-sm">
          {% if brandTitle %}
            <p class="font-h4 max-w-[509px]">{{ brandTitle }}</p>
          {% endif %}

          <div class="flex flex-col gap-xs font-small">
            {% if orgName %}
              <span class="font-semibold">{{ orgName }}</span>
            {% endif %}
            {% if address %}
              <span class="text-off-white/80">{{ address|nl2br }}</span>
            {% endif %}
            {% if phone %}
              <span class="flex items-center gap-xs text-off-white/80">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <span>{{ phone }}</span>
              </span>
            {% endif %}
            {% if email %}
              <a class="flex items-center gap-xs text-off-white/80 hover:text-off-white transition-colors" href="mailto:{{ email }}">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="m2 6 10 7L22 6"></path>
                </svg>
                <span>{{ email }}</span>
              </a>
            {% endif %}
          </div>

          {% if socials %}
            <div class="flex flex-row flex-wrap gap-xs">
              {% for social in socials %}
                {% if social.url and social.platform %}
                  <a class="w-11 h-11 rounded-cta bg-white/20 flex items-center justify-center text-off-white transition-colors hover:bg-white/40 [&_svg]:w-[22px] [&_svg]:h-[22px] [&_svg]:fill-current"
                    href="{{ social.platform == 'email' ? 'mailto:' ~ social.url : social.url }}"
                    {% if social.platform != 'email' %} target="_blank" rel="noreferrer noopener"{% endif %}
                    aria-label="{{ social.platform|capitalize }}" title="{{ social.platform|capitalize }}">
                    {% include 'assets/icons/' ~ social.platform ~ '.svg' ignore missing %}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          {% if donateLink %}
            <a class="button button--primary mt-xs"
              href="{{ donateLink.url }}"
              {% if donateLink.target %} target="{{ donateLink.target }}" rel="noreferrer noopener"{% endif %}>
              <span>{{ donateLink.title }}</span>
            </a>
          {% endif %}
        </div>

        {# Nav columns + transparency badge #}
        <div class="flex flex-col gap-lg">
          {% if columns %}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-sm sm:gap-md">
              {% for column in columns %}
                <div class="flex flex-col">
                  {% if column.heading %}
                    <p class="font-semibold mb-sm">{{ column.heading }}</p>
                  {% endif %}
                  {% if column.links %}
                    <ul class="flex flex-col gap-xs font-body">
                      {% for item in column.links %}
                        {% if item.link %}
                          <li>
                            <a class="text-off-white/70 hover:text-off-white transition-colors ease-in-out"
                              href="{{ item.link.url }}"
                              {% if item.link.target %} target="{{ item.link.target }}" rel="noreferrer noopener"{% endif %}>
                              {{ item.link.title }}
                            </a>
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if transparencyBadge %}
            <div class="mt-auto flex justify-start lg:justify-end">
              {% if transparencyBadgeLink %}
                <a href="{{ transparencyBadgeLink }}" target="_blank" rel="noreferrer noopener">
              {% endif %}
                <img class="h-[54px] w-auto" src="{{ transparencyBadge.src }}" alt="{{ transparencyBadge.alt|e|default('') }}" loading="lazy">
              {% if transparencyBadgeLink %}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    {# ── Bottom legal bar — wave-backed full-width band (lighter green) ── #}
    <div class="relative mt-xl">
      {# Decorative wave lifting the lighter-green legal strip out of the footer #}
      <div class="absolute inset-0 pointer-events-none select-none [&>svg]:h-full [&>svg]:w-full" aria-hidden="true">
        {% include 'assets/images/bgWave.svg' ignore missing %}
      </div>

      <div class="boxed relative z-10 !py-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-sm font-small">
          {% if legalLinks %}
            <div class="flex flex-row flex-wrap gap-x-sm gap-y-xs">
              {% for l in legalLinks %}
                {% if l.link %}
                  <a class="text-off-white/60 hover:text-off-white transition-colors ease-in-out"
                    href="{{ l.link.url }}"
                    {% if l.link.target %} target="{{ l.link.target }}" rel="noreferrer noopener"{% endif %}>
                    {{ l.link.title }}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
          {% if copyrightText %}
            <span class="text-off-white/40">{{ copyrightText }}</span>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</flynt-component>
