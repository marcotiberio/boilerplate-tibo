<flynt-component
  load:on="visible" name="BlockHero"
  id="hero"
  class="relative w-full min-h-screen overflow-hidden flex flex-col"
  style="
    color: {% if options.colorText %}{{ options.colorText }}{% else %}var(--black){% endif %};
    background-color: {% if options.colorBackground %}{{ options.colorBackground }}{% else %}var(--bright-green){% endif %};">

  {% if backgroundImage %}
    <img
      class="absolute inset-0 w-full h-full object-cover z-0"
      src="{{ backgroundImage.src }}"
      alt="{{ backgroundImage.alt|e | default('') }}"
      loading="eager">
  {% endif %}

  {# Decorative green blobs (placeholder until SVG assets are exported from Figma) #}
  <div class="pointer-events-none absolute -top-24 -left-24 w-[40rem] h-[40rem] rounded-full bg-bright-green/60 blur-2xl z-[1]"></div>
  <div class="pointer-events-none absolute top-1/3 -right-32 w-[44rem] h-[44rem] rounded-full border-2 border-black/10 z-[1]"></div>

  <div class="relative z-10 boxed flex flex-col flex-1 gap-lg py-sm">
    {# Top row: kicker + date #}
    <div class="flex flex-row justify-between items-start gap-sm">
      {% if kicker %}<span class="h3 uppercase">{{ kicker }}</span>{% endif %}
      {% if dateText %}<span class="h3">{{ dateText }}</span>{% endif %}
    </div>

    {# Brand wordmark #}
    <div class="flex-1 flex items-center">
      <img class="w-full max-w-[1136px] h-auto" src="{{ wordmarkUrl }}" alt="LOOPTOPIA">
    </div>

    {# Headline + scroll chevron #}
    <div class="flex flex-col gap-sm max-w-[60rem]">
      {% if headline %}<h1 class="h1">{{ headline }}</h1>{% endif %}
      {% if scrollAnchor %}
        <a href="{{ scrollAnchor }}" class="inline-flex w-12 h-12 items-center justify-center rounded-full border-2 border-black" aria-label="{{ __('Scroll down', 'flynt') }}">
          <img class="w-5 h-5" src="{{ chevronUrl }}" alt="" aria-hidden="true">
        </a>
      {% endif %}
    </div>

    {# Funders #}
    {% if funders.logos %}
      <div class="flex flex-col items-end gap-xs ml-auto">
        {% if funders.label %}<span class="font-body !mb-0 text-sm">{{ funders.label }}</span>{% endif %}
        <div class="flex flex-row flex-wrap items-center gap-sm">
          {% for item in funders.logos %}
            {% if item.logo %}
              <img class="h-12 w-auto object-contain" src="{{ item.logo.src }}" alt="{{ item.logo.alt|e | default('') }}">
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</flynt-component>
