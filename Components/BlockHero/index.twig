<flynt-component
  load:on="visible" name="BlockHero"
  id="hero"
  class="relative w-full min-h-[calc(100vh-72px)] overflow-hidden flex flex-col"
  style="
    color: {% if options.colorText %}{{ options.colorText }}{% else %}var(--black){% endif %};
    background-color: {% if options.colorBackground %}{{ options.colorBackground }}{% else %}var(--white){% endif %};">

  {% if backgroundImage %}
    <img
      class="absolute inset-0 w-full h-full object-cover z-0"
      src="{{ backgroundImage.src }}"
      alt="{{ backgroundImage.alt|e | default('') }}"
      loading="eager">
  {% endif %}

  <div class="relative z-10 boxed flex flex-col justify-between flex-1 gap-lg py-sm">
    <div class="flex flex-col gap-xs md:gap-0">
      {# Top row: kicker + date #}
      <div class="flex flex-row justify-between items-start gap-sm">
        {% if kicker %}<span class="font-h1Hero">{{ kicker }}</span>{% endif %}
        {% if dateText %}<span class="font-h1Hero">{{ dateText }}</span>{% endif %}
      </div>

      {# Brand wordmark #}
      <div class="flex items-center">
        <img class="w-full h-auto" src="{{ wordmarkUrl }}" alt="LOOPTOPIA">
      </div>
    </div>

    <div class="flex flex-col">
      {# Headline + scroll chevron #}
      <div class="flex flex-col gap-md w-full md:w-1/3">
        {% if headline %}<h1 class="font-bodyLarge">{{ headline }}</h1>{% endif %}
        {% if scrollAnchor %}
          <a href="{{ scrollAnchor }}" class="inline-flex w-full h-full items-start justify-start" aria-label="{{ __('Scroll down', 'flynt') }}">
            <svg class="w-10 h-auto" width="19" height="11" viewBox="0 0 19 11" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1.33333 1.33334L9.33333 9.33334L17.3333 1.33334" stroke="black" stroke-width="2.66667" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>
      {# Funders #}
      {% if funders.logos or funders2.logos %}
        <div class="flex flex-row flex-wrap items-start gap-sm ml-auto">
          {% for group in [funders, funders2] %}
            {% if group.logos %}
              <div class="flex flex-col items-end gap-xs">
                {% if group.label %}<span class="font-body !mb-0 text-sm">{{ group.label }}</span>{% endif %}
                <div class="flex flex-row flex-wrap items-center gap-sm">
                  {% for item in group.logos %}
                    {% if item.logo %}
                      <img class="h-12 w-auto object-contain" src="{{ item.logo.src }}" alt="{{ item.logo.alt|e | default('') }}">
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</flynt-component>
