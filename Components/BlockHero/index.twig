<flynt-component
  load:on="idle"
  name="BlockHero"
  class="relative w-full overflow-hidden bg-dark-green"
  x-data="{ playing: true }">

  {# Background media #}
  <div class="absolute inset-0 w-full h-full z-0">
    {% if video.url %}
      <video
        x-ref="video"
        class="w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
        poster="{{ image.src|default('') }}">
        <source src="{{ video.url }}" type="{{ video.mime_type|default('video/mp4') }}" />
      </video>
    {% else %}
      {% if image %}
        <img
          data-ref="backgroundImageDesktop"
          class="hidden lgplus:block w-full h-full object-cover"
          src="{{ image.src }}"
          alt="{{ image.alt|e | default('') }}"
          loading="eager"
        />
      {% endif %}
      {% if imageMobile %}
        <img
          data-ref="backgroundImageMobile"
          class="block lgplus:hidden w-full h-full object-cover"
          src="{{ imageMobile.src }}"
          alt="{{ image.alt|e | default('') }}"
          loading="eager"
        />
      {% endif %}
    {% endif %}
  </div>

  {# Legibility scrim over the media (both image and video) — 40% black over
     the dark-green base set on the component (Figma hero overlay fill). #}
  <div class="absolute inset-0 z-0 bg-black/40 pointer-events-none"></div>

  {# Play / pause control (only when a video is set) #}
  {% if video.url %}
    <button
      type="button"
      class="absolute right-sm bottom-sm md:bottom-auto md:top-1/2 md:-translate-y-1/2 z-20 flex items-center justify-center w-14 h-11 rounded-cta bg-off-white/20 backdrop-blur-sm text-off-white transition-colors hover:bg-off-white/30"
      @click="playing ? $refs.video.pause() : $refs.video.play(); playing = !playing"
      :aria-label="playing ? '{{ __('Pause video', 'flynt') }}' : '{{ __('Play video', 'flynt') }}'">
      {# Pause icon #}
      <svg x-show="playing" class="w-4 h-4" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
        <rect x="2.2" y="0.2" width="3" height="14" rx="1" />
        <rect x="9.2" y="0.2" width="3" height="14" rx="1" />
      </svg>
      {# Play icon #}
      <svg x-show="!playing" x-cloak class="w-4 h-4" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
        <path d="M2 1.2 12.5 7 2 12.8Z" />
      </svg>
    </button>
  {% endif %}

  {# Content #}
  <div class="relative z-10 boxed !pb-xl min-h-[85vh] flex flex-col justify-end items-center text-center gap-sm">
    {% if title %}
      {% set tag = titleTag|default('h1') %}
      <{{ tag }} class="font-{{ titleSize|default('h1') }} text-off-white max-w-[722px]">{{ title }}</{{ tag }}>
    {% endif %}

    <div class="flex flex-col md:flex-row flex-wrap gap-xs justify-center items-center">
      {% if primaryButton %}
        <a
          class="button button--primary !w-full !md:w-auto"
          href="{{ primaryButton.url }}"
          {% if primaryButton.target %} target="{{ primaryButton.target }}" rel="noreferrer noopener"{% endif %}>
          <span>{{ primaryButton.title }}</span>
        </a>
      {% endif %}
      {% if secondaryButton %}
        <a
          class="button button--glass !w-full !md:w-auto"
          href="{{ secondaryButton.url }}"
          {% if secondaryButton.target %} target="{{ secondaryButton.target }}" rel="noreferrer noopener"{% endif %}>
          <span>{{ secondaryButton.title }}</span>
        </a>
      {% endif %}
    </div>
  </div>

  {# Bottom curve divider — Figma hero bottom edge, transitions the media into
     the off-white page. Scales with width so the curve stays true to the design. #}
  <svg
    class="absolute bottom-0 left-0 w-full h-auto z-10 pointer-events-none text-off-white"
    viewBox="0 0 1440 48.34"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true">
    <path fill="currentColor" d="M1440,48.33 C958.077,48.33 576.135,0 0,48.33 L0,48.34 L1440,48.34 Z"/>
  </svg>
</flynt-component>
