<flynt-component
  load:on="visible" name="BlockHero"
  id="hero"
  class="relative w-full min-h-screen overflow-hidden flex flex-col"
  style="
    color: {% if options.colorText %}{{ options.colorText }}{% else %}var(--black){% endif %};
    background-color: {% if options.colorBackground %}{{ options.colorBackground }}{% else %}var(--white){% endif %};">

  {% if backgroundImage %}
    <img
      class="absolute inset-0 w-full h-full object-cover z-0"
      src="{{ backgroundImage.src }}"
      alt="{{ backgroundImage.alt|e | default('') }}"
      loading="eager">
  {% endif %}

  <div class="relative z-10 boxed flex flex-col justify-between flex-1 gap-lg py-sm">
    <div class="flex flex-col gap-xs md:gap-0">
      {# Top row: kicker + date #}
      <div class="flex flex-row justify-between items-start gap-sm">
        {% if kicker %}<span class="font-h1Hero">{{ kicker }}</span>{% endif %}
        {% if dateText %}<span class="font-h1Hero">{{ dateText }}</span>{% endif %}
      </div>

      {# Brand wordmark #}
      <div class="flex items-center">
        <img class="w-full h-auto" src="{{ wordmarkUrl }}" alt="LOOPTOPIA">
      </div>
    </div>

    <div class="flex flex-col">
      {# Headline + scroll chevron #}
      <div class="flex flex-col gap-sm w-full md:w-1/3">
        {% if headline %}<h1 class="font-bodyLarge">{{ headline }}</h1>{% endif %}
        {% if scrollAnchor %}
          <a href="{{ scrollAnchor }}" class="inline-flex w-12 h-12 items-center justify-center rounded-full border-2 border-black" aria-label="{{ __('Scroll down', 'flynt') }}">
            <img class="w-5 h-5" src="{{ chevronUrl }}" alt="" aria-hidden="true">
          </a>
        {% endif %}
      </div>

      {# Funders #}
      {% if funders.logos %}
        <div class="flex flex-col items-end gap-xs ml-auto">
          {% if funders.label %}<span class="font-body !mb-0 text-sm">{{ funders.label }}</span>{% endif %}
          <div class="flex flex-row flex-wrap items-center gap-sm">
            {% for item in funders.logos %}
              {% if item.logo %}
                <img class="h-12 w-auto object-contain" src="{{ item.logo.src }}" alt="{{ item.logo.alt|e | default('') }}">
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</flynt-component>
