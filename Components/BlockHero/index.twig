<flynt-component load:on="visible" name="BlockHero" class="relative w-full overflow-hidden">
  {# Background image #}
  <div class="absolute inset-0 w-full h-full z-0">
    {% if image %}
      <img
        data-ref="backgroundImageDesktop"
        class="hidden lgplus:block w-full h-full object-cover"
        src="{{ image.src }}"
        alt="{{ image.alt|e | default('') }}"
        loading="eager"
      />
    {% endif %}
    {% if imageMobile %}
      <img
        data-ref="backgroundImageMobile"
        class="block lgplus:hidden w-full h-full object-cover"
        src="{{ imageMobile.src }}"
        alt="{{ image.alt|e | default('') }}"
        loading="eager"
      />
    {% endif %}
  </div>

  {# Dark overlay for legibility #}
  <div class="absolute inset-0 z-0 bg-black/20 pointer-events-none"></div>

  {# Content #}
  <div class="relative z-10 boxed min-h-[80vh] flex flex-col justify-center items-center text-center gap-sm">
    {% if titleHtml %}
      <div class="wysiwyg text-white">{{ titleHtml|e('wp_kses_post') }}</div>
    {% endif %}
    <div class="flex flex-wrap gap-xs justify-center">
      {% if primaryButton %}
        <a
          class="button button--fullOrange"
          href="{{ primaryButton.url }}"
          {% if primaryButton.target %} target="{{ primaryButton.target }}" rel="noreferrer noopener"{% endif %}>
          {{ primaryButton.title }}
        </a>
      {% endif %}
      {% if secondaryButton %}
        <a
          class="button button--muted"
          href="{{ secondaryButton.url }}"
          {% if secondaryButton.target %} target="{{ secondaryButton.target }}" rel="noreferrer noopener"{% endif %}>
          {{ secondaryButton.title }}
        </a>
      {% endif %}
    </div>
  </div>

  {# Floating highlight card (desktop only) #}
  {% if highlight.title %}
    <div
      x-data="{ show: true }"
      x-show="show"
      class="hidden lg:block absolute right-sm top-1/3 z-20 w-[306px] bg-white rounded-card p-xs shadow-lg">
      <button
        @click="show=false"
        aria-label="Schließen"
        class="absolute top-xs right-xs z-10 text-dark-brown leading-none">×</button>
      {% if highlight.image %}
        <img
          class="rounded-card object-cover w-full h-[181px]"
          src="{{ highlight.image.src }}"
          alt="{{ highlight.image.alt|e | default('') }}"
          loading="lazy"
        />
      {% endif %}
      <div class="font-h3 text-dark-brown">{{ highlight.title }}</div>
      {% if highlight.link %}
        <a
          class="button button--link"
          href="{{ highlight.link.url }}"
          {% if highlight.link.target %} target="{{ highlight.link.target }}" rel="noreferrer noopener"{% endif %}>
          {{ highlight.link.title }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  {# Bottom wave divider #}
  <svg
    class="absolute bottom-0 left-0 w-full h-[60px] lg:h-[120px] z-10 pointer-events-none"
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg">
    <path fill="#fcfbfa" d="M0,40 C360,120 1080,0 1440,60 L1440,120 L0,120 Z"/>
  </svg>
</flynt-component>
