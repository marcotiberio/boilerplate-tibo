<flynt-component
  load:on="visible"
  name="SliderBoxText"
  class="section section--{{ options.sectionTheme|default('mist') }} {{ options.decoration == 'topo' ? 'decoration--topo' }} overflow-hidden">
  <script type="application/json">{{ jsonData|json_encode }}</script>
  <div class="content">
    <div class="flex flex-row justify-between items-end gap-sm mb-md">
      {% if title %}
        <h2 class="h2 uppercase !mb-0">{{ title|e }}</h2>
      {% endif %}
      {% if boxes|length > 1 %}
        <div class="flex flex-row gap-xs shrink-0">
          <button data-ref="prev" type="button" class="slider-button" aria-label="{{ __('Previous', 'flynt')|e('html_attr') }}">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button data-ref="next" type="button" class="slider-button" aria-label="{{ __('Next', 'flynt')|e('html_attr') }}">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {% endif %}
    </div>

    <div data-ref="slider" class="slider swiper-container">
      <div class="swiper-wrapper">
        {% for box in boxes %}
          <figure class="swiper-slide slider-item bg-forest text-white p-md m-0 flex flex-col justify-center gap-sm text-center">
            <blockquote class="m-0" lang="de">
              <p class="slider-quote !mb-0">„{{ box.quote|e|nl2br }}“</p>
            </blockquote>
            {% if box.attribution %}
              <figcaption class="meta">{{ box.attribution|e }}</figcaption>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    </div>
  </div>
</flynt-component>
