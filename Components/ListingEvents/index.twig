<flynt-component
  name="ListingEvents"
  class="section section--{{ options.sectionTheme|default('mist') }} {{ options.decoration == 'topo' ? 'decoration--topo' }}">
  <div class="content" {% include 'templates/partials/_filter-scope.twig' %}>
    {% include 'templates/partials/_heading.twig' with { title: title } only %}

    {% if filterGroups %}
      {% include 'templates/partials/_filter-chips.twig' with { groups: filterGroups, allLabel: labels.filterAll } only %}
    {% endif %}

    {% if items %}
      <ul class="flex flex-col gap-sm list-none p-0 m-0">
        {% for item in items %}
          <li x-show="matches({{ item.filterTerms|json_encode|e('html_attr') }})" x-transition.opacity>
            <article class="listingEvents-row flex flex-col md:flex-row md:items-center gap-sm bg-white text-ink p-sm">
              <div class="listingEvents-date flex flex-col justify-center gap-min bg-sage text-forest p-sm shrink-0">
                <time class="listingEvents-day" datetime="{{ item.dateTime|e('html_attr') }}">{{ item.date|e }}</time>
                {% if item.time %}
                  <span class="meta">{{ item.time|e }}</span>
                {% endif %}
              </div>
              <div class="flex flex-col gap-min grow">
                {% if item.meta %}
                  <p class="meta !mb-0">{{ item.meta|e }}</p>
                {% endif %}
                <h3 class="!mb-0">{{ item.title|e }}</h3>
                {% if item.excerpt %}
                  <p class="!mb-0">{{ item.excerpt|e }}</p>
                {% endif %}
              </div>
              <a class="button button--forest shrink-0" href="{{ item.link|e('esc_url') }}" aria-label="{{ labels.register|e }}: {{ item.title|e }}">{{ labels.register|e }}</a>
            </article>
          </li>
        {% endfor %}
      </ul>
      {% if filterGroups %}
        <p class="mt-sm" x-cloak x-show="{{ items|map(i => i.filterTerms)|json_encode|e('html_attr') }}.every(t => !matches(t))">{{ labels.noResults|e }}</p>
      {% endif %}
    {% else %}
      <p>{{ labels.noResults|e }}</p>
    {% endif %}

    {% if allLink %}
      <div class="flex justify-center mt-md">
        <a class="button button--auto" href="{{ allLink.url|e('esc_url') }}" {% if allLink.target %}target="{{ allLink.target|e('html_attr') }}" rel="noopener noreferrer"{% endif %}>{{ allLink.title|e }}</a>
      </div>
    {% endif %}
  </div>
</flynt-component>
