<flynt-component
  name="BlockBannerCta"
  class="section section--{{ options.sectionTheme|default('forest') }} {{ options.decoration == 'topo' ? 'decoration--topo' }} overflow-hidden">
  {% if backgroundImage %}
    <img
      class="lazyload absolute inset-0 w-full h-full object-cover brightness-[0.35]"
      src="{{ backgroundImage.src|resize(32) }}"
      data-srcset="{{ function('wp_get_attachment_image_srcset', backgroundImage.id) }}"
      data-sizes="auto"
      alt=""
      aria-hidden="true">
  {% endif %}
  <div class="content flex flex-col gap-sm">
    {% if label %}
      <p class="eyebrow !mb-0">{{ label|e }}</p>
    {% endif %}
    {% if title %}
      <h2 class="bannerCta-title bannerCta-title--{{ titleStyle|default('heading') }} !mb-0 max-w-[56rem]">{{ title|e }}</h2>
    {% endif %}
    {% if contentHtml %}
      <div class="wysiwyg max-w-[56rem]">{{ contentHtml|e('wp_kses_post') }}</div>
    {% endif %}
    {% include 'templates/partials/_buttons.twig' with { buttons: buttons, class: 'mt-xs' } only %}
  </div>
</flynt-component>
