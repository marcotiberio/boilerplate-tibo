{% set theme = options.theme|default('beige') %}
{% set layout = options.layout|default('centered') %}
{% set isDark = theme in ['terracotta', 'dark-green'] %}
{% set surfaceClass = {
  'beige': 'bg-beige text-black',
  'offWhite': 'bg-off-white text-black',
  'terracotta': 'bg-terracotta text-off-white',
  'dark-green': 'bg-dark-green text-off-white'
}[theme] %}

<flynt-component
  load:on="idle"
  name="BlockBannerCta"
  class="w-full">
  <div class="boxed">
    {% if layout == 'split' %}

      {# Split — title and body side by side on desktop, icon badge top-right #}
      <div class="relative {{ surfaceClass }} rounded-banner overflow-hidden p-sm lg:p-md">
        {% if image %}
          <div class="cta-badge absolute top-sm right-sm lg:top-md lg:right-md flex items-center justify-center w-[72px] h-[72px] rounded-cta {{ isDark ? 'bg-white/[0.08]' : 'bg-dark-brown/[0.05]' }}">
            <img class="w-11 h-11 object-contain" src="{{ image.src }}" alt="{{ image.alt|e | default('') }}" loading="lazy" />
          </div>
        {% endif %}

        {% if eyebrow %}
          <p class="font-body opacity-90 {{ image ? 'pr-[88px]' : '' }}">{{ eyebrow }}</p>
        {% endif %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-sm lg:gap-sm {% if eyebrow %}mt-sm{% endif %}">
          {% if title %}
            {% set tag = titleTag|default('h2') %}
            <{{ tag }} class="font-{{ titleSize|default('h2') }} lg:w-[358px] lg:shrink-0">{{ title }}</{{ tag }}>
          {% endif %}
          <div class="flex-1 flex flex-col gap-sm lg:pt-xs">
            {% if contentHtml %}
              <div class="wysiwyg">{{ contentHtml|e('wp_kses_post') }}</div>
            {% endif %}
            {% if primaryButton or secondaryButton %}
              <div class="flex flex-wrap gap-xs">
                {% if primaryButton %}
                  <a class="button button--primary" href="{{ primaryButton.url }}"{% if primaryButton.target %} target="{{ primaryButton.target }}" rel="noreferrer noopener"{% endif %}>
                    {{ primaryButton.title }}
                  </a>
                {% endif %}
                {% if secondaryButton %}
                  <a class="button button--secondary" href="{{ secondaryButton.url }}"{% if secondaryButton.target %} target="{{ secondaryButton.target }}" rel="noreferrer noopener"{% endif %}>
                    {{ secondaryButton.title }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

    {% else %}

      {# Centered — logo, eyebrow, title, body and buttons stacked and centered #}
      <div class="{{ surfaceClass }} rounded-banner overflow-hidden flex flex-col items-center text-center gap-sm px-sm py-lg lg:px-xl lg:py-xl">
        {% if image %}
          <img
            class="w-[86px] h-auto {{ isDark ? '' : 'mix-blend-multiply opacity-100' }}"
            src="{{ image.src }}"
            alt="{{ image.alt|e | default('') }}"
            loading="lazy"
          />
        {% endif %}
        {% if eyebrow %}
          <p class="font-body opacity-90">{{ eyebrow }}</p>
        {% endif %}
        {% if title %}
          {% set tag = titleTag|default('h2') %}
          <{{ tag }} class="font-{{ titleSize|default('h2') }} max-w-[800px]">{{ title }}</{{ tag }}>
        {% endif %}
        {% if contentHtml %}
          <div class="wysiwyg max-w-[588px]">{{ contentHtml|e('wp_kses_post') }}</div>
        {% endif %}
        {% if primaryButton or secondaryButton %}
          <div class="flex flex-wrap gap-xs justify-center mt-xs">
            {% if primaryButton %}
              <a class="button button--primary" href="{{ primaryButton.url }}"{% if primaryButton.target %} target="{{ primaryButton.target }}" rel="noreferrer noopener"{% endif %}>
                {{ primaryButton.title }}
              </a>
            {% endif %}
            {% if secondaryButton %}
              <a class="button button--secondary" href="{{ secondaryButton.url }}"{% if secondaryButton.target %} target="{{ secondaryButton.target }}" rel="noreferrer noopener"{% endif %}>
                {{ secondaryButton.title }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

    {% endif %}
  </div>
</flynt-component>
