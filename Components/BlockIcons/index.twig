<flynt-component
  load:on="visible"
  name="BlockIcons"
  class="w-full bg-off-white"
  style="
    {% if options.colorText %}color: {{ options.colorText }};{% endif %}
    {% if options.colorBackground %}background-color: {{ options.colorBackground }};{% endif %}">
  <div class="boxed">
    {% if title %}
      {% set tag = titleTag|default('h2') %}
      <{{ tag }} class="font-{{ titleSize|default('h2') }} text-dark-green mb-xl">{{ title }}</{{ tag }}>
    {% endif %}

    {% if items %}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-lg gap-y-xl">
        {% for item in items %}
          <div class="flex h-full flex-col gap-sm">
            {% if item.icon %}
              <img
                class="h-14 w-14 object-contain"
                src="{{ item.icon.src }}"
                alt="{{ item.icon.alt|e|default('') }}"
                loading="lazy">
            {% endif %}

            <div class="flex flex-1 flex-col items-start justify-between gap-4">
              <div class="flex flex-col items-start gap-4">
                {% if item.title %}
                  <h3 class="font-{{ titleStyle|default('h2') }} text-black">{{ item.title }}</h3>
                {% endif %}
                {% if item.text %}
                  <p class="font-body text-black">{{ item.text }}</p>
                {% endif %}
              </div>

              {% if item.button %}
                <a
                  class="button button--primary"
                  href="{{ item.button.url }}"
                  {% if item.button.target %} target="{{ item.button.target }}" rel="noreferrer noopener"{% endif %}>
                  <span>{{ item.button.title }}</span>
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</flynt-component>
