<flynt-component
  load:on="idle"
  name="BlockMediaQuote"
  class="relative w-full overflow-hidden bg-dark-green"
  x-data="{ playing: true }">

  {# Background media #}
  <div class="absolute inset-0 w-full h-full z-0">
    {% if video.url %}
      <video
        x-ref="video"
        class="w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
        poster="{{ image.src|default('') }}">
        <source src="{{ video.url }}" type="{{ video.mime_type|default('video/mp4') }}" />
      </video>
    {% else %}
      {% if image %}
        <img
          class="hidden lgplus:block w-full h-full object-cover"
          src="{{ image.src }}"
          alt="{{ image.alt|e | default('') }}"
          loading="lazy"
        />
      {% endif %}
      {% if imageMobile %}
        <img
          class="block lgplus:hidden w-full h-full object-cover"
          src="{{ imageMobile.src }}"
          alt="{{ image.alt|e | default('') }}"
          loading="lazy"
        />
      {% endif %}
    {% endif %}
  </div>

  {# Overlay for legibility #}
  <div class="absolute inset-0 z-0 bg-dark-green/40 pointer-events-none"></div>

  {# Play / pause control (only when a video is set) #}
  {% if video.url %}
    <button
      type="button"
      class="absolute right-sm bottom-sm z-20 flex items-center justify-center w-14 h-11 rounded-cta bg-off-white/20 backdrop-blur-sm text-off-white transition-colors hover:bg-off-white/30 lg:bottom-auto lg:top-1/2 lg:-translate-y-1/2"
      @click="playing ? $refs.video.pause() : $refs.video.play(); playing = !playing"
      :aria-label="playing ? '{{ __('Pause video', 'flynt') }}' : '{{ __('Play video', 'flynt') }}'">
      {# Pause icon #}
      <svg x-show="playing" class="w-4 h-4" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
        <rect x="2.2" y="0.2" width="3" height="14" rx="1" />
        <rect x="9.2" y="0.2" width="3" height="14" rx="1" />
      </svg>
      {# Play icon #}
      <svg x-show="!playing" x-cloak class="w-4 h-4" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
        <path d="M2 1.2 12.5 7 2 12.8Z" />
      </svg>
    </button>
  {% endif %}

  {# Quote #}
  <div class="relative z-10 boxed min-h-[600px] lg:min-h-[742px] flex items-center justify-center text-center">
    {% if highlight or quote %}
      <blockquote class="font-h2 max-w-screen-tablet">
        {% if highlight %}<span class="text-off-white">{{ highlight }} </span>{% endif %}{% if quote %}<span data-ref="quoteFill" class="text-off-white/30">{{ quote }}</span>{% endif %}
      </blockquote>
    {% endif %}
  </div>
</flynt-component>
