<flynt-component
  name="GridSteps"
  class="section section--{{ options.sectionTheme|default('sage') }} {{ options.decoration == 'topo' ? 'decoration--topo' }}">
  <div class="content">
    {% include 'templates/partials/_heading.twig' with { label: label, title: title, description: description } only %}

    {% if steps %}
      {% if options.layout == 'list' %}
        <ol class="steps steps--list flex flex-col">
          {% for step in steps %}
            <li class="flex flex-row gap-sm py-sm border-b border-forest/15">
              <span class="steps-number" aria-hidden="true">{{ loop.index }}</span>
              <div class="flex flex-col gap-min">
                <h3 class="uppercase !mb-0">{{ step.title|e }}</h3>
                {% if step.text %}
                  <p class="!mb-0">{{ step.text|e('wp_kses_post') }}</p>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ol>
      {% else %}
        <ol class="steps steps--cards grid grid-cols-1 md:grid-cols-2 gap-sm">
          {% for step in steps %}
            <li class="flex flex-col gap-xs bg-white text-ink p-sm">
              <span class="steps-number" aria-hidden="true">{{ loop.index }}</span>
              <h3 class="uppercase !mb-0 mt-xs">{{ step.title|e }}</h3>
              {% if step.text %}
                <p class="!mb-0">{{ step.text|e('wp_kses_post') }}</p>
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      {% endif %}
    {% endif %}

    {% if footnote %}
      <p class="meta mt-sm !mb-0">{{ footnote|e }}</p>
    {% endif %}
    {% include 'templates/partials/_buttons.twig' with { buttons: buttons, class: 'mt-md' } only %}
  </div>
</flynt-component>
